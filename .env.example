APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/confluencr
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/confluencr_test
REDIS_URL=redis://localhost:6379/0

PROCESSING_DELAY_SECONDS=30
PROCESSING_LEASE_SECONDS=120
DISPATCH_STALE_SECONDS=120
RECONCILE_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=20

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=confluencr
